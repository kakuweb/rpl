# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tranne il modello: serve a chi clona per sapere quali variabili servire.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# log del server di sviluppo
.logs/

# Foto originali: materiale grezzo, non serve al sito (usa public/).
# Fuori dal repo perché git non dimentica: ogni scatto aggiunto peserebbe
# per sempre sulla storia e su ogni clone. Si condividono a parte.
/img/
/Carosello outing/
